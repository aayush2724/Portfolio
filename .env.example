# Live "Currently vibing to" card in the Beyond Code section.
# Both are optional: leave them unset and the card shows its static fallback.
# Copy to .env.local for development; set the same two on Vercel for production.

# Last.fm username whose scrobbles the card shows.
VITE_LASTFM_USER=

# Read-only Last.fm API key — create one at https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=
