# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite). Copy to .env.local for development; set the same on Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# Live "Currently vibing to" card in the Beyond Code section (optional; the
# card shows its static fallback when unset).
VITE_LASTFM_USER=
# Read-only Last.fm API key — https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=

# Origin of the Portfolio Intelligence Agent API (Milestone 2+). Unset = the
# assistant runs in its scripted offline mode. Must also appear in the CSP
# connect-src in vercel.json.
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Backend (FastAPI, ./backend). Copy to backend/.env for development; set the
# same variables on Render. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Pooled PostgreSQL URL (asyncpg driver). Local: the docker container from
# backend/README.md. Neon: append ?ssl=require to the pooled connection string.
DATABASE_URL=postgresql+asyncpg://pia:pia@127.0.0.1:5434/pia_dev
# Direct (non-pooler) URL for migrations, advisory locks and the LangGraph
# checkpointer. Optional locally; required on Neon.
DATABASE_URL_DIRECT=
# Used by the test suite only; never points at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://pia:pia@127.0.0.1:5434/pia_test

# GitHub fine-grained personal access token, READ ONLY: repository access
# limited to the monitored public repositories, permissions
# Contents: read and Metadata: read. Raises the API limit and unlocks the
# private repo. Locally you can use `gh auth token`.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_MAX_FILE_BYTES=40000
GITHUB_MAX_TOTAL_BYTES=400000

# The repository the publisher opens pull requests against (Milestone 5).
PORTFOLIO_REPO=aayush2724/Portfolio
PORTFOLIO_BRANCH=main
PORTFOLIO_SITE_URL=https://aayush-2724.vercel.app

# Comma-separated exact origins allowed to call the public API.
CORS_ALLOWED_ORIGINS=https://aayush-2724.vercel.app,http://localhost:5173,http://localhost:4173

# Seed file written by `node scripts/export-seed.mjs` (relative to ./backend).
SEED_FILE=seeds/projects.seed.json

# ── LLM via OpenRouter (any OpenAI-compatible endpoint works) ──────────────
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# Your OpenRouter key. Unset = the assistant reports itself offline and the
# site falls back to the scripted guide.
LLM_API_KEY=
# Model ids are OpenRouter ids. The chat default is free; free models are rate-limited per
# OpenRouter account (check openrouter.ai/docs for current limits; buying credits once raises
# them). Any one free model can be throttled upstream, so LLM_FALLBACK_MODELS lists more
# free models OpenRouter tries in order; only when all are busy does the site answer from the
# scripted guide. Paid options (USD per million tokens in/out, 2026-11-08):
# anthropic/claude-haiku-5.5 0.10/0.50 · anthropic/claude-sonnet-5.5 2/10 ·
# google/gemini-3.5-flash-lite 0.30/2.50 · openai/gpt-5.4-mini 0.75/4.50
LLM_CHAT_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_FALLBACK_MODELS=recursive/flint-v1.0:free,google/gemma-4-31b-it:free
LLM_ANALYSIS_MODEL=nvidia/nemotron-3.5-super-vl:free
# Public repositories only (owner decision 2026-11-09): private repos are not ingested or analysed.
INCLUDE_PRIVATE_REPOS=false
# Only used if INCLUDE_PRIVATE_REPOS=true: a paid model for private code (never a free endpoint).
LLM_PRIVATE_REPO_MODEL=
LLM_TIMEOUT_SECONDS=25
# Reasoning models can use the whole output budget thinking. "minimal" measured fastest
# (first text ~10 s, full answer ~14 s on a large architecture question).
LLM_REASONING_EFFORT=minimal
# Hard daily cap on model spend, enforced from llm_calls in the database.
LLM_DAILY_BUDGET_USD=2.0
# Free models cost $0, so the dollar cap cannot protect the free quota. This caps model
# requests per UTC day (chat + analysis); keep it below your OpenRouter free daily limit.
LLM_DAILY_REQUEST_CAP=800
# Optional price overrides: {"vendor/model": [in_per_m, out_per_m]}
LLM_PRICES_JSON=

# ── Visitor assistant limits ───────────────────────────────────────────────
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_PER_SESSION_DAILY=40
# Random string mixed into the daily IP hash (never store or log raw IPs).
RATE_LIMIT_SALT=
# X-Forwarded-For entries appended by proxies we trust, counted from the right.
# 0 locally (use the socket peer); assumed 1 on Render (verify in M6 from two
# different networks). Never trust the leftmost entry.
TRUSTED_PROXY_HOPS=0
ASSISTANT_MAX_OUTPUT_TOKENS=4000
ASSISTANT_TIMEOUT_SECONDS=45
# Message text is NOT stored unless this is true; privacy.html must match.
STORE_CONVERSATIONS=false
CONVERSATION_RETENTION_DAYS=30
